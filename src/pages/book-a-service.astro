                        <g clip-path="url(#clip0_14032_793)">
                          <path d="M8 3.3335V12.6668" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M3.33337 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clippath id="clip0_14032_793">
                            <rect width="16" height="16" fill="currentColor"></rect>
                          </clippath>
