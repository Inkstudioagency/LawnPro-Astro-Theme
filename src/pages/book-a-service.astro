---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout title="Book A Service || Lawn Care & Pest Control Astro Theme" description="Request a free, no-pressure quote for lawn care or pest control. Share your property details and receive a personalized response within 24 hours." wfPage="6aba295c0e791c71047d0ee5" footerTarget="3e39f3bf-a180-f92a-a6e7-c9cff2d0644d">
    <div class="main">
      <section class="section bg-fantasy">
        <div class="section-gap speacer-3xl">
          <div class="w-layout-blockcontainer container w-container">
            <div class="w-layout-grid contact-grid">
              <div class="contact-left">
                <div class="contact-heading-wrap">
                  <div class="badge">
                    <div class="badge-dot"></div>
                    <div class="badge-text">GET STARTED</div>
                  </div>
                  <h1 class="is-charcoal-black">Book your service in 60 seconds</h1>
                  <div class="contact-p-wrap">
                    <p class="font-small">Tell us about your property and we&#x27;ll send a tailored quote within 24 hours. No contracts, no pressure, no spam.</p>
                  </div>
                </div>
                <ul role="list" class="contact-list">
                  <li class="contact-list-item">
                    <div>Free, no-obligation quote</div>
                  </li>
                  <li class="contact-list-item">
                    <div>Quote back within 24 hours</div>
                  </li>
                  <li class="contact-list-item">
                    <div>Licensed, insured &amp; guaranteed</div>
                  </li>
                  <li class="contact-list-item">
                    <div>Flexible scheduling, cancel anytime</div>
                  </li>
                </ul>
                <div class="contact-us-info-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" class="phone-icon">
                    <g clip-path="url(#clip0_14038_3962)">
                      <path d="M9 4H5C4.46957 4 3.96086 4.21071 3.58579 4.58579C3.21071 4.96086 3 5.46957 3 6C3.23705 9.90074 4.8935 13.5798 7.65683 16.3432C10.4202 19.1065 14.0993 20.763 18 21C18.5304 21 19.0391 20.7893 19.4142 20.4142C19.7893 20.0391 20 19.5304 20 19V15L15 13L13.5 15.5C11.3285 14.429 9.57096 12.6715 8.5 10.5L11 9L9 4Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M15 7V7.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M18 7V7.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M21 7V7.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </g>
                    <defs>
                      <clippath id="clip0_14038_3962">
                        <rect width="24" height="24" fill="currentColor"></rect>
                      </clippath>
                    </defs>
                  </svg>
                  <div class="contact-info-right">
                    <div class="font-extra-small">Prefer to call?</div>
                    <a href="tel:(123)345-6789" class="contact-number">(123) 345-6789</a>
                  </div>
                </div>
              </div>
              <div class="contact-right">
                <div class="font-medium">Request your free quote</div>
                <div class="contact-form-main w-form">
                  <form id="email-form" name="email-form" data-name="Email Form" method="get" class="contact-form" data-wf-page-id="6aba295c0e791c71047d0ee5" data-wf-element-id="96e7a113-6781-5927-446c-c1877f2b4db1">
                    <div class="row">
                      <div class="group"><label for="name" class="field-label">Name</label><input class="text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Yout name" type="text" id="name"></div>
                      <div class="group"><label for="Email" class="field-label">Email address</label><input class="text-field w-input" maxlength="256" name="Email" data-name="Email" placeholder="Your email" type="email" id="Email" required=""></div>
                    </div>
                    <div class="group"><label for="Phone" class="field-label">Phone number</label><input class="text-field w-input" maxlength="256" name="Phone" data-name="Phone" placeholder="Your phone number" type="tel" id="Phone" required=""></div>
                    <div class="group"><label for="field" class="field-label">Service needed</label><select id="field" name="field" data-name="Field" class="text-field w-select">
                        <option value="">Select a service…</option>
                        <option value="First">First choice</option>
                        <option value="Second">Second choice</option>
                        <option value="Third">Third choice</option>
                      </select></div>
                    <div class="group"><label for="Location" class="field-label">Property address</label><input class="text-field w-input" maxlength="256" name="Location" data-name="Location" placeholder="123 Main St, City" type="text" id="Location"></div>
                    <div class="group"><label for="field-2" class="field-label">Anything we should know?</label><textarea placeholder="Example Text" maxlength="5000" id="Message-Area" name="field-2" data-name="Field 2" class="text-field message-area w-input"></textarea></div><input type="submit" data-wait="Please wait..." class="submit-button w-button" value="Send Message">
                    <div class="group"><label for="field-2" class="field-label">We&#x27;ll never share your info. Expect a reply within 24 hours.</label></div>
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="error-message w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="f3f2dd4d-0c79-308c-aa65-342cd8c6c5bf" data-wf-variant-state="base" class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="faq-main">
              <div class="faq-left">
                <div class="faq-left-sticky">
                  <div class="badge">
                    <div class="badge-dot"></div>
                    <div class="badge-text">FAQ</div>
                  </div>
                  <div class="faq-heading-wrap">
                    <h2 data-wf-target="[[[&quot;f3f2dd4d-0c79-308c-aa65-342cd8c6c5bf&quot;,&quot;f3f2dd4d-0c79-308c-aa65-342cd8c6c5c9&quot;],[&quot;b1a9d660-3199-eaa7-450b-079c16b3309b&quot;]]]">Frequently Asked Questions</h2>
                  </div>
                  <div class="faq-p-wrap">
                    <p data-wf-target="[[[&quot;f3f2dd4d-0c79-308c-aa65-342cd8c6c5bf&quot;,&quot;f3f2dd4d-0c79-308c-aa65-342cd8c6c5cc&quot;],[&quot;b1a9d660-3199-eaa7-450b-079c16b3309b&quot;]]]">Find quick answers to common questions about our lawn care, pest control, scheduling, and service process.</p>
                  </div>
                </div>
              </div>
              <div class="faq-right">
                <div class="faq-card">
                  <div class="faq-card-top">
                    <div class="font-normal">How quickly can I schedule my first service?</div>
                    <div class="faq-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 16 16" fill="none" class="faq-arrow">
                        <g clip-path="url(#clip0_14032_784)">
                          <path d="M3.33337 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clippath id="clip0_14032_784">
                            <rect width="16" height="16" fill="currentColor"></rect>
                          </clippath>
                        </defs>
                      </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 16 16" fill="none" class="faq-arrow is-absolute">
                        <g clip-path="url(#clip0_14032_793)">
                          <path d="M8 3.3335V12.6668" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M3.33337 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clippath id="clip0_14032_793">
                            <rect width="16" height="16" fill="currentColor"></rect>
                          </clippath>
                        </defs>
                      </svg></div>
                  </div>
                  <div class="faq-p-wrapper">
                    <p class="faq-p">In most cases, we can schedule your first visit within 2–5 business days. Availability may vary depending on your location and the season, but we&#x27;ll always work to find the earliest convenient appointment.</p>
                  </div>
                </div>
                <div class="faq-card">
                  <div class="faq-card-top">
                    <div class="font-normal">Are your treatments safe for children and pets?</div>
                    <div class="faq-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 16 16" fill="none" class="faq-arrow">
                        <g clip-path="url(#clip0_14032_784)">
                          <path d="M3.33337 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs>
                          <clippath id="clip0_14032_784">
                            <rect width="16" height="16" fill="currentColor"></rect>
                          </clippath>
