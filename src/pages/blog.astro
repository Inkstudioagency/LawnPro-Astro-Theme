---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPostList from '../components/cms/FeaturedPostList.astro';
import PostList from '../components/cms/PostList.astro';
import { getPosts } from '../lib/content';
const posts = await getPosts();
const featured = posts.filter((post) => post.featured);
const regular = posts.filter((post) => !post.featured);
---

<BaseLayout title="Blog || Lawn Care & Pest Control Astro Theme" description="Read practical lawn care, pest control, seasonal maintenance, and eco-friendly yard guides designed to help homeowners create healthier outdoor spaces." wfPage="6aba295c0e791c71047d0eed" footerTarget="5b39091f-13ca-e616-cfeb-161ac997b54a">
    <div class="main">
      <div class="blog-hero-area">
        <section class="section blog-hero">
          <div class="section-gap spacer-7xl">
            <div class="w-layout-blockcontainer container w-container">
              <div class="inner-hero-header">
                <div class="hero-badge">
                  <div class="badge-dot"></div>
                  <div class="badge-text">BLOG &amp; GUIDES</div>
                </div>
                <div class="max-width-40">
                  <h1 class="inner-heading">Lawn &amp; home care, made simple</h1>
                </div>
                <div class="pricing-hero-p-wrap max-width-34">
                  <p class="hero-summary center">Practical tips, seasonal checklists, and the science behind a healthier yard from the Evergreen team.</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="post-header">
              <div class="post-header-title">Featured Post</div>
            </div>
            <div class="w-layout-grid post-grid">
              <div class="post-colletion-block">
                <FeaturedPostList posts={featured.slice(0, 1)} />
              </div>
              <div class="post-colletion-block">
                <FeaturedPostList posts={featured.slice(1, 2)} />
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section bg-desert-storm">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-header">
              <div class="max-width-40">
                <h2 class="section-heading align-center">Expert Advice for Healthier Outdoor Living</h2>
              </div>
            </div>
            <div class="blog-collection-wrap">
              <PostList posts={regular} wrapImage />
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="f3f2dd4d-0c79-308c-aa65-342cd8c6c5bf" data-wf-variant-state="base" class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="faq-main">
              <div class="faq-left">
