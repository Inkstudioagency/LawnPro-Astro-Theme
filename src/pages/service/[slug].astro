                    <div class="hero-badge">
                      <div class="badge-dot"></div>
                      <div class="badge-text">{service.badge}</div>
                    </div>
                    <h1 class="is-charcoal-black">{service.title}</h1>
                    <div class="max-width-34">
                      <p class="service-hero-p">{service.detailsSummary}</p>
                    </div>
                  </div>
                  <div class="service-button-wrapper">
