---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceList from '../components/cms/ServiceList.astro';
import { getServices } from '../lib/content';
const services = await getServices();
---

<BaseLayout title="Service || Lawn Care & Pest Control Astro Theme" description="Explore lawn treatments, mowing and edging, pest control, mosquito and tick control, mulch, aeration, and seeding in the Myrtle Beach area." wfPage="6aba295c0e791c71047d0eeb" footerTarget="7edaf2e0-51f5-ea89-31e4-3f08fd33772c">
    <div class="main">
      <div class="service-hero-area">
        <section class="section service-hero">
          <div class="section-gap spacer-7xl">
            <div class="w-layout-blockcontainer container w-container">
              <div class="inner-hero-header">
                <div class="hero-badge">
                  <div class="badge-dot"></div>
                  <div class="badge-text">OUR SERVICES</div>
                </div>
                <div class="max-width-55">
                  <h1 class="inner-heading">Lawn care &amp; pest control, done the right way</h1>
                </div>
                <div class="pricing-hero-p-wrap max-width-34">
                  <p class="hero-summary center">From the first mow to mosquito-free summers, we care for your property quietly, eco-friendly, and with clear pricing.</p>
                </div>
                <div class="button-wrap">
                  <a data-wf--primary-button--variant="base" data-wf-component-id="fe1f102b-9d85-5da5-5b1c-595a29c97112" data-wf-variant-state="base" href="/book-a-service" class="primary-button w-inline-block">
                    <div href="#" class="button-text-wrap">
                      <div class="footer-link-text is-one">Get a Free Quote</div>
                      <div class="footer-link-text is-two">Get a Free Quote</div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <section data-wf-component-id="1836b4e4-1603-6d57-afee-4a58e83b5dae" data-wf-variant-state="base" class="section marque">
        <div class="section-gap spacer-xl">
          <div class="marque-main">
            <div class="logo-marque-main">
              <div class="logo-marque-list"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-3.webp" alt="Lightbox company logo with a cube icon to the left of the word Lightbox." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-1_1Company-logo-1.webp" alt="Interlock company logo with two interlocked rings to the left of the text." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"></div>
              <div class="logo-marque-list"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-3.webp" alt="Lightbox company logo with a cube icon to the left of the word Lightbox." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-1_1Company-logo-1.webp" alt="Interlock company logo with two interlocked rings to the left of the text." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"></div>
              <div class="logo-marque-list"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-3.webp" alt="Lightbox company logo with a cube icon to the left of the word Lightbox." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-1_1Company-logo-1.webp" alt="Interlock company logo with two interlocked rings to the left of the text." class="company-logo"><img loading="lazy" src="/images/Company-logo.webp" alt="Hexsmith logo with a hexagon icon to the left of the company name in gray text." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-4.webp" alt="Magnolia company logo with stylized M icon and the word Magnolia in gray." class="company-logo"><img loading="lazy" src="/images/Company-logo-6.webp" alt="PictelAI company logo with a pixelated cross symbol and text." class="company-logo"><img loading="lazy" src="/images/Company-logo-5_1Company-logo-5.webp" alt="Norse Star company logo with a star-shaped asterisk symbol." class="company-logo"></div>
              <div class="marque-overlay"></div>
              <div class="marque-overlay right"></div>
            </div>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-header">
              <div class="badge">
                <div class="badge-dot"></div>
                <div class="badge-text">WHAT WE OFFER</div>
              </div>
              <div class="max-width-40">
                <h2 class="align-center">All You Need for a Greener, Healthier Property</h2>
              </div>
            </div>
            <div class="service-main">
              <ServiceList services={services} />
            </div>
          </div>
        </div>
      </section>
    </div>
</BaseLayout>
