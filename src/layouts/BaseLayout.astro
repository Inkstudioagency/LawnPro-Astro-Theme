---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Webflow page id: interactions (IX) are bound to it. */
  wfPage: string;
  /** Per-page id Webflow uses to target the footer CTA animation; null hides the shared footer. */
  footerTarget: string | null;
  image?: string;
}

const { title, description, wfPage, footerTarget, image = '/images/og-image.webp' } = Astro.props;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
